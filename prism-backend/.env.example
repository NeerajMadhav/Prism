ENVIRONMENT=development
PORT=8000
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
# Optional — leave empty to run API + DB without Redis (cache/queues degrade).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30
PRISM_INTERNAL_SECRET=change-me-internal-secret-not-jwt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/auth/microsoft/callback
# Preferred mail transport (Microsoft Graph). When set, Graph is used before SES.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=
AWS_SES_REGION=us-east-1
AWS_SES_FROM=noreply@prism.io
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PRISM_AWS_ACCOUNT_ID=123456789012
TEAMS_SIGNING_SECRET=
SLACK_SIGNING_SECRET=
FRONTEND_URL=http://localhost:3000
WORKER_CONCURRENCY=8
API_INTERNAL_URL=http://127.0.0.1:8000
